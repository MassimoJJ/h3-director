{
  "name": "h3-director",
  "version": "0.1.0",
  "private": true,
  "description": "MiniMax H3 Director Studio - clean director UI over a headless ComfyUI engine",
  "workspaces": [
    "backend",
    "web"
  ],
  "scripts": {
    "typecheck": "npm run typecheck -w backend && npm run typecheck -w web",
    "dev:backend": "npm run dev -w backend",
    "dev:web": "npm run dev -w web",
    "build": "npm run build -w web",
    "start": "npm run start -w backend",
    "verify:timeline": "node scripts/timeline-align.check.cjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "playwright-core": "^1.63.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
